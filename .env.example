# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imagespace?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="imagespace-development-secret-change-in-production-min32chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Email
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ImageSpace <noreply@imagespace.com>"

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="imagespace"
R2_PUBLIC_DOMAIN=""

# Background Maintenance Cron Secret
CRON_SECRET="your-secure-random-32-char-cron-secret"
