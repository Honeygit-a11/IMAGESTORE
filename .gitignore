# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
/.nyc_output
/test-results

# next.js build outputs
/.next/
/out/

# production outputs
/build
/dist

# OS files
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# debug & execution logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# environment variables (keep secrets private)
.env
.env*.local
.env.development
.env.production
.env.test

# IDE & Editor files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI / Local IDE & agent caches
.eanvi/
.claude/
.gemini/
.cursor/
.agents/
.system_generated/
scratch/

# vercel
.vercel

# typescript build cache & generated declarations
*.tsbuildinfo
next-env.d.ts
